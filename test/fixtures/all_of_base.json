{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/all_of_base.json",
  "title": "Base Schema",
  "description": "A base schema for inheritance.",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp."
    }
  }
}
