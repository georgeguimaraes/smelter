{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Root Self Reference Test",
  "description": "Tests that $ref: '#' resolves to the root schema itself",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    }
  },
  "$defs": {
    "extended": {
      "title": "Extended Version",
      "allOf": [
        {
          "$ref": "#"
        },
        {
          "type": "object",
          "properties": {
            "selected": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
