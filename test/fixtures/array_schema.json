{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/array.json",
  "title": "Array Schema",
  "description": "A schema with array types.",
  "type": "object",
  "properties": {
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of tags."
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "List of scores."
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "item.json"
      },
      "description": "List of items."
    }
  }
}
