{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/simple.json",
  "title": "Simple Schema",
  "description": "A simple test schema with basic properties.",
  "type": "object",
  "required": ["name", "age"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The person's name."
    },
    "age": {
      "type": "integer",
      "description": "The person's age in years.",
      "minimum": 0
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "The person's email address."
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  }
}
