{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/defs_with_local_refs.json",
  "title": "Defs With Local Refs",
  "description": "A schema where $defs reference other $defs.",
  "type": "object",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "profile": {
      "title": "Profile",
      "type": "object",
      "required": ["version", "name"],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "name": {
          "type": "string"
        }
      }
    }
  }
}
