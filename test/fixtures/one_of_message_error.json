{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/message_error.json",
  "title": "Message Error",
  "description": "An error message variant.",
  "type": "object",
  "required": ["type", "message"],
  "properties": {
    "type": {
      "type": "string",
      "const": "error"
    },
    "message": {
      "type": "string"
    },
    "code": {
      "type": "integer"
    }
  }
}
