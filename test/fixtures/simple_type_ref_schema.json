{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/simple_type_ref.json",
  "title": "Simple Type Ref Schema",
  "description": "A schema with refs to simple types (not generatable).",
  "type": "object",
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Version in YYYY-MM-DD format."
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "properties": {
    "version": {
      "$ref": "#/$defs/version"
    },
    "contact": {
      "$ref": "#/$defs/email"
    }
  }
}
